ATHAR_DB_HOST=127.0.0.1
ATHAR_DB_PORT=3306
ATHAR_DB_NAME=athar
ATHAR_DB_USER=athar_app
ATHAR_DB_PASSWORD=replace-with-a-long-random-secret
ATHAR_BACKUP_KEY=replace-with-64-hex-characters-stored-outside-the-repository
ATHAR_BASE_URL=https://athar.example.com
ATHAR_SETTINGS_KEY=replace-with-a-separate-64-character-hex-key
# Optional fallback if the administrator stores the approved key in the dashboard.
ATHAR_DORAR_API_TOKEN=
# Push delivery is server-side only. Keep the service-account JSON outside this repository.
ATHAR_PUSH_PROVIDER=disabled
ATHAR_FCM_PROJECT_ID=
ATHAR_FCM_SERVICE_ACCOUNT_FILE=
# Optional explicit 12-hex environment id. If empty, backend hashes ATHAR_BASE_URL + /api/v1/.
# Set this to the Android AppGraph partition for strict staging/production separation.
ATHAR_PUSH_ENVIRONMENT=

