ATHAR_DB_HOST=127.0.0.1
ATHAR_DB_PORT=3306
ATHAR_DB_NAME=athar
ATHAR_DB_USER=athar_app
ATHAR_DB_PASSWORD=replace-with-a-long-random-secret
ATHAR_BACKUP_KEY=replace-with-64-hex-characters-stored-outside-the-repository
ATHAR_BASE_URL=https://athar.example.com
ATHAR_SETTINGS_KEY=replace-with-a-separate-64-character-hex-key
# Optional fallback if the administrator stores the approved key in the dashboard.
ATHAR_DORAR_API_TOKEN=

# Independent durable Email payload key; retain the original while queued ciphertext exists.
ATHAR_EMAIL_OUTBOX_KEY=replace-with-an-independent-64-character-hex-key
